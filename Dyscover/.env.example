# true  = run with the built-in scripted demo backend (no server needed)
# false = talk to the real backend (see docs/API.md)
VITE_USE_MOCK=true

# true = show the server-backed email/password login even for the scripted demo.
# Leave unset for the local no-server demo.
VITE_REQUIRE_LOGIN=false

# Leave empty for the Vite dev proxy or same-origin public hosting (required for judge login cookies).
VITE_API_BASE=
